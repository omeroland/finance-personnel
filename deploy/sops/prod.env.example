# Modèle (valeurs factices) du fichier chiffré deploy/sops/prod.sops.env. Voir deploy/README.md.
# Créer : cp prod.env.example prod.env && éditer, puis
#   sops encrypt --input-type dotenv --output-type dotenv prod.env > prod.sops.env && rm prod.env
# Ne jamais versionner prod.env (non chiffré).
FINANCE_PUBLIC_ORIGIN=https://finance.example.org
TRAEFIK_ACME_EMAIL=admin@example.org
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
# Hexadécimal : il entre dans une URL de connexion (openssl rand -hex 24).
FINANCE_APP_PASSWORD=change-me
