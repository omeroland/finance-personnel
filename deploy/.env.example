# Valeurs factices. `make up` génère deploy/.env (ignoré par git) avec des mots de passe aléatoires.
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
# Profil prod seulement : courriel Let's Encrypt.
TRAEFIK_ACME_EMAIL=admin@example.org
# Origine publique (schéma, hôte, port) ; défaut local https://localhost:9443. En prod : https://votre-domaine
# FINANCE_PUBLIC_ORIGIN=https://finance.example.org
