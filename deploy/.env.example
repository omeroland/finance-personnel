# Valeurs factices. `make up` génère deploy/.env (ignoré par git) avec des mots de passe aléatoires.
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
# Profil prod seulement : courriel Let's Encrypt.
TRAEFIK_ACME_EMAIL=admin@example.org
# Origine publique (schéma, hôte, port) ; défaut local https://localhost:9443. En prod : https://votre-domaine
# FINANCE_PUBLIC_ORIGIN=https://finance.example.org
# Sauvegardes (P1-20, profil `backup`). Valeurs factices ; clé PUBLIQUE age seulement, jamais la privée.
# Génération de la clé de production : voir deploy/backup/README.md (sur ton poste, pas ici).
AGE_RECIPIENT=age1remplacez-par-votre-cle-publique
BACKUP_BUCKET=finance-sauvegardes
BACKUP_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
BACKUP_S3_REGION=gra
BACKUP_S3_ACCESS_KEY_ID=change-me
BACKUP_S3_SECRET_ACCESS_KEY=change-me
# ALERT_WEBHOOK_URL=https://exemple.org/hook
